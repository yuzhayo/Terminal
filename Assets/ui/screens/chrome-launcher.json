{
  "id": "chrome-launcher-screen",
  "type": "Screen",
  "style": {
    "$ref": "styles.surface"
  },
  "routeId": "chrome-launcher",
  "children": [
    {
      "id": "chrome-launcher-shell",
      "type": "Container",
      "style": {
        "$ref": "styles.surface"
      },
      "layout": {
        "width": "fill",
        "height": "fill"
      },
      "direction": "column",
      "gap": 10,
      "overflow": "scroll",
      "padding": {
        "left": 24,
        "top": 24,
        "right": 24,
        "bottom": 24
      },
      "children": [
        {
          "id": "chrome-launcher-title",
          "type": "Text",
          "style": {
            "$ref": "styles.text-title"
          },
          "text": "Chrome Launcher",
          "variant": "title"
        },
        {
          "id": "chrome-launcher-description",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "text": "Buka URL atau bookmark memakai profile Chrome yang terlihat.",
          "variant": "body"
        },
        {
          "id": "chrome-launcher-profile",
          "type": "Combo",
          "style": {
            "$ref": "styles.combo"
          },
          "layout": {
            "width": "fill"
          },
          "itemsBinding": {
            "$bind": "viewState.chromeProfiles"
          },
          "selectedValueBinding": {
            "$bind": "viewState.selectedChromeProfile"
          },
          "placeholder": "Pilih profile Chrome",
          "events": {
            "changed": {
              "action": "select-chrome-profile",
              "payload": {}
            }
          }
        },
        {
          "id": "chrome-launcher-url",
          "type": "Input",
          "style": {
            "$ref": "styles.input"
          },
          "layout": {
            "width": "fill"
          },
          "valueBinding": {
            "$bind": "viewState.chromeUrl"
          },
          "placeholder": "https://example.com",
          "events": {
            "changed": {
              "action": "update-chrome-url",
              "payload": {}
            }
          }
        },
        {
          "id": "chrome-launcher-bookmarks",
          "type": "List",
          "style": {
            "$ref": "styles.list"
          },
          "layout": {
            "width": "fill",
            "height": 112
          },
          "automation": {
            "name": "Bookmark Chrome"
          },
          "itemsBinding": {
            "$bind": "viewState.chromeBookmarks"
          },
          "itemTemplate": {
            "id": "chrome-bookmark-row",
            "type": "Card",
            "style": {
              "$ref": "styles.card"
            },
            "children": []
          },
          "selectedIdBinding": {
            "$bind": "viewState.selectedChromeBookmark"
          },
          "rowHeight": 32,
          "overscanRows": 2,
          "selection": "single",
          "emptyText": "Belum ada bookmark",
          "events": {
            "selectionChanged": {
              "action": "select-chrome-bookmark",
              "payload": {}
            }
          }
        },
        {
          "id": "chrome-launcher-status",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "textBinding": {
            "$bind": "viewState.chromeStatus"
          },
          "variant": "caption",
          "automation": {
            "name": "Status Chrome Launcher",
            "live": "polite"
          }
        },
        {
          "id": "chrome-launcher-actions",
          "type": "Container",
          "style": {
            "$ref": "styles.surface"
          },
          "layout": {
            "width": "fill"
          },
          "direction": "row",
          "gap": 8,
          "children": [
            {
              "id": "chrome-launcher-run",
              "type": "Button",
              "style": {
                "$ref": "styles.button-primary"
              },
              "label": "Buka Chrome",
              "variant": "primary",
              "events": {
                "click": {
                  "action": "launch-chrome",
                  "payload": {}
                }
              }
            },
            {
              "id": "chrome-launcher-profile-manager",
              "type": "Button",
              "style": {
                "$ref": "styles.button-navigation"
              },
              "label": "Profile Manager",
              "variant": "navigation",
              "events": {
                "click": {
                  "action": "navigate-route",
                  "payload": {
                    "routeId": "chrome-profile-manager"
                  }
                }
              }
            },
            {
              "id": "chrome-launcher-terminal",
              "type": "Button",
              "style": {
                "$ref": "styles.button-subtle"
              },
              "label": "Terminal",
              "variant": "subtle",
              "events": {
                "click": {
                  "action": "navigate-route",
                  "payload": {
                    "routeId": "terminal"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
