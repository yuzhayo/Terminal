{
  "id": "chrome-profile-manager-screen",
  "type": "Screen",
  "style": {
    "$ref": "styles.surface"
  },
  "routeId": "chrome-profile-manager",
  "children": [
    {
      "id": "chrome-profile-manager-shell",
      "type": "Container",
      "style": {
        "$ref": "styles.surface"
      },
      "layout": {
        "width": "fill",
        "height": "fill"
      },
      "direction": "column",
      "gap": 10,
      "overflow": "scroll",
      "padding": {
        "left": 24,
        "top": 24,
        "right": 24,
        "bottom": 24
      },
      "children": [
        {
          "id": "chrome-profile-manager-title",
          "type": "Text",
          "style": {
            "$ref": "styles.text-title"
          },
          "text": "Chrome Profile Manager",
          "variant": "title"
        },
        {
          "id": "chrome-profile-manager-description",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "text": "Pilih profile Chrome yang ditampilkan pada launcher.",
          "variant": "body"
        },
        {
          "id": "chrome-profile-manager-runtime",
          "type": "Combo",
          "style": {
            "$ref": "styles.combo"
          },
          "layout": {
            "width": "fill"
          },
          "placeholder": "Pilih runtime Chrome",
          "itemsBinding": {
            "$bind": "viewState.chromeRuntimes"
          },
          "selectedValueBinding": {
            "$bind": "viewState.selectedChromeRuntime"
          },
          "events": {
            "changed": {
              "action": "select-chrome-runtime",
              "payload": {}
            }
          }
        },
        {
          "id": "chrome-profile-manager-refresh",
          "type": "Button",
          "style": {
            "$ref": "styles.button-default"
          },
          "label": "Refresh profiles",
          "events": {
            "click": {
              "action": "refresh-chrome-profiles",
              "payload": {}
            }
          }
        },
        {
          "id": "chrome-profile-manager-list",
          "type": "List",
          "style": {
            "$ref": "styles.list"
          },
          "layout": {
            "width": "fill",
            "height": 112
          },
          "automation": {
            "name": "Profile Chrome"
          },
          "itemsBinding": {
            "$bind": "viewState.managedChromeProfiles"
          },
          "itemTemplate": {
            "id": "managed-chrome-profile-row",
            "type": "Card",
            "style": {
              "$ref": "styles.card"
            },
            "children": []
          },
          "selectedIdBinding": {
            "$bind": "viewState.selectedManagedProfile"
          },
          "rowHeight": 32,
          "selection": "single",
          "events": {
            "selectionChanged": {
              "action": "select-managed-chrome-profile",
              "payload": {}
            }
          }
        },
        {
          "id": "chrome-profile-manager-name",
          "type": "Input",
          "style": {
            "$ref": "styles.input"
          },
          "layout": {
            "width": "fill"
          },
          "valueBinding": {
            "$bind": "viewState.profileName"
          },
          "placeholder": "Nama profile",
          "readOnly": true
        },
        {
          "id": "chrome-profile-manager-enabled",
          "type": "Toggle",
          "style": {
            "$ref": "styles.toggle"
          },
          "label": "Profile aktif",
          "checkedBinding": {
            "$bind": "viewState.profileEnabled"
          },
          "events": {
            "changed": {
              "action": "toggle-chrome-profile-enabled",
              "payload": {}
            }
          }
        },
        {
          "id": "chrome-profile-manager-status",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "textBinding": {
            "$bind": "viewState.profileStatus"
          },
          "variant": "caption",
          "automation": {
            "name": "Status Profile Manager",
            "live": "polite"
          }
        },
        {
          "id": "chrome-profile-manager-actions",
          "type": "Container",
          "style": {
            "$ref": "styles.surface"
          },
          "layout": {
            "width": "fill"
          },
          "direction": "row",
          "gap": 8,
          "children": [
            {
              "id": "chrome-profile-manager-save",
              "type": "Button",
              "style": {
                "$ref": "styles.button-primary"
              },
              "label": "Simpan profile terlihat",
              "variant": "primary",
              "events": {
                "click": {
                  "action": "save-chrome-profiles",
                  "payload": {}
                }
              }
            },
            {
              "id": "chrome-profile-manager-back",
              "type": "Button",
              "style": {
                "$ref": "styles.button-subtle"
              },
              "label": "Chrome Launcher",
              "variant": "subtle",
              "events": {
                "click": {
                  "action": "navigate-route",
                  "payload": {
                    "routeId": "chrome-launcher"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
