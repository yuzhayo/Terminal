{
  "id": "json-editor-screen",
  "type": "Screen",
  "style": {
    "$ref": "styles.surface"
  },
  "routeId": "json-editor",
  "children": [
    {
      "id": "json-editor-shell",
      "type": "Container",
      "style": {
        "$ref": "styles.surface"
      },
      "layout": {
        "width": "fill",
        "height": "fill"
      },
      "direction": "column",
      "gap": 10,
      "overflow": "scroll",
      "padding": {
        "left": 24,
        "top": 24,
        "right": 24,
        "bottom": 24
      },
      "children": [
        {
          "id": "json-editor-title",
          "type": "Text",
          "style": {
            "$ref": "styles.text-title"
          },
          "text": "JSON Editor",
          "variant": "title"
        },
        {
          "id": "json-editor-description",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "text": "Edit Claude settings.json dengan validation, backup, restore, dan atomic save.",
          "variant": "body"
        },
        {
          "id": "json-editor-target",
          "type": "Combo",
          "style": {
            "$ref": "styles.combo"
          },
          "layout": {
            "width": "fill"
          },
          "itemsBinding": {
            "$bind": "viewState.jsonEditorTargets"
          },
          "selectedValueBinding": {
            "$bind": "viewState.selectedJsonEditorTarget"
          },
          "placeholder": "Pilih settings.json",
          "events": {
            "changed": {
              "action": "select-json-editor-target",
              "payload": {}
            }
          }
        },
        {
          "id": "json-editor-draft",
          "type": "Input",
          "style": {
            "$ref": "styles.input"
          },
          "layout": {
            "width": "fill",
            "height": 176
          },
          "valueBinding": {
            "$bind": "viewState.jsonEditorDraft"
          },
          "mode": "multiline",
          "maxLength": 0,
          "placeholder": "{ }",
          "events": {
            "changed": {
              "action": "update-json-editor-draft",
              "payload": {}
            }
          }
        },
        {
          "id": "json-editor-status",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "textBinding": {
            "$bind": "viewState.jsonEditorStatus"
          },
          "variant": "caption",
          "automation": {
            "name": "Status JSON Editor",
            "live": "polite"
          }
        },
        {
          "id": "json-editor-actions",
          "type": "Container",
          "style": {
            "$ref": "styles.surface"
          },
          "layout": {
            "width": "fill"
          },
          "direction": "row",
          "gap": 8,
          "children": [
            {
              "id": "json-editor-validate",
              "type": "Button",
              "style": {
                "$ref": "styles.button-default"
              },
              "label": "Validasi JSON",
              "events": {
                "click": {
                  "action": "validate-json-editor",
                  "payload": {}
                }
              }
            },
            {
              "id": "json-editor-restore",
              "type": "Button",
              "style": {
                "$ref": "styles.button-default"
              },
              "label": "Restore backup",
              "events": {
                "click": {
                  "action": "restore-json-editor-backup",
                  "payload": {}
                }
              }
            },
            {
              "id": "json-editor-save",
              "type": "Button",
              "style": {
                "$ref": "styles.button-primary"
              },
              "label": "Simpan JSON",
              "variant": "primary",
              "events": {
                "click": {
                  "action": "save-json-editor",
                  "payload": {}
                }
              }
            },
            {
              "id": "json-editor-back",
              "type": "Button",
              "style": {
                "$ref": "styles.button-subtle"
              },
              "label": "JSON INJECT",
              "variant": "subtle",
              "events": {
                "click": {
                  "action": "navigate-route",
                  "payload": {
                    "routeId": "json-inject"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
