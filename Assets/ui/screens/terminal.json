{
  "id": "terminal-screen",
  "type": "Screen",
  "style": {
    "$ref": "styles.surface"
  },
  "routeId": "terminal",
  "children": [
    {
      "id": "terminal-shell",
      "type": "Container",
      "style": {
        "$ref": "styles.surface"
      },
      "layout": {
        "width": "fill",
        "height": "fill"
      },
      "direction": "column",
      "gap": 12,
      "overflow": "scroll",
      "padding": {
        "left": 24,
        "top": 24,
        "right": 24,
        "bottom": 24
      },
      "children": [
        {
          "id": "terminal-title",
          "type": "Text",
          "style": {
            "$ref": "styles.text-title"
          },
          "text": "Terminal",
          "variant": "title"
        },
        {
          "id": "terminal-description",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "text": "Buka terminal pada folder dan target yang dipilih.",
          "variant": "body"
        },
        {
          "id": "terminal-input",
          "type": "Input",
          "style": {
            "$ref": "styles.input"
          },
          "layout": {
            "width": "fill"
          },
          "valueBinding": {
            "$bind": "viewState.terminalInput"
          },
          "placeholder": "Pilih folder kerja terminal",
          "events": {
            "changed": {
              "action": "update-terminal-draft",
              "payload": {}
            }
          }
        },
        {
          "id": "terminal-profile",
          "type": "Combo",
          "style": {
            "$ref": "styles.combo"
          },
          "layout": {
            "width": "fill"
          },
          "itemsBinding": {
            "$bind": "viewState.terminalProfiles"
          },
          "selectedValueBinding": {
            "$bind": "viewState.selectedTerminalProfile"
          },
          "placeholder": "Pilih profil terminal",
          "maxVisibleItems": 6,
          "popupMaxHeight": 320,
          "events": {
            "changed": {
              "action": "select-terminal-profile",
              "payload": {}
            }
          }
        },
        {
          "id": "terminal-options",
          "type": "Card",
          "style": {
            "$ref": "styles.card"
          },
          "layout": {
            "width": "fill"
          },
          "interactive": true,
          "tabStop": true,
          "automation": {
            "name": "Opsi Terminal"
          },
          "children": [
            {
              "id": "terminal-confirm",
              "type": "Checkbox",
              "style": {
                "$ref": "styles.checkbox"
              },
              "label": "Konfirmasi sebelum menjalankan",
              "checkedBinding": {
                "$bind": "viewState.confirmBeforeRun"
              },
              "events": {
                "changed": {
                  "action": "toggle-confirm-before-run",
                  "payload": {}
                }
              }
            },
            {
              "id": "terminal-venv-enabled",
              "type": "Toggle",
              "style": {
                "$ref": "styles.toggle"
              },
              "label": "Aktifkan .venv bila tersedia",
              "checkedBinding": {
                "$bind": "viewState.terminalVenvEnabled"
              },
              "events": {
                "changed": {
                  "action": "toggle-terminal-venv",
                  "payload": {}
                }
              }
            }
          ],
          "events": {
            "activate": {
              "action": "activate-terminal-options",
              "payload": {}
            }
          }
        },
        {
          "id": "terminal-recent-folders",
          "type": "List",
          "style": {
            "$ref": "styles.list"
          },
          "layout": {
            "width": "fill",
            "height": 120
          },
          "automation": {
            "name": "Recent folder"
          },
          "itemsBinding": {
            "$bind": "viewState.recentFolders"
          },
          "itemTemplate": {
            "id": "terminal-recent-folder-row",
            "type": "Card",
            "style": {
              "$ref": "styles.card"
            },
            "children": []
          },
          "selectedIdBinding": {
            "$bind": "viewState.selectedRecentFolder"
          },
          "rowHeight": 32,
          "overscanRows": 2,
          "selection": "single",
          "emptyText": "Belum ada recent folder",
          "scrollbar": "auto",
          "events": {
            "selectionChanged": {
              "action": "select-terminal-folder",
              "payload": {}
            }
          }
        },
        {
          "id": "terminal-run-action",
          "type": "Button",
          "style": {
            "$ref": "styles.button-primary"
          },
          "label": "Jalankan terminal",
          "variant": "primary",
          "events": {
            "click": {
              "action": "run-terminal",
              "payload": {}
            }
          }
        },
        {
          "id": "terminal-status",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "textBinding": {
            "$bind": "viewState.terminalStatus"
          },
          "variant": "caption",
          "automation": {
            "name": "Status Terminal",
            "live": "polite"
          }
        },
        {
          "id": "terminal-json-inject-action",
          "type": "Button",
          "style": {
            "$ref": "styles.button-navigation"
          },
          "label": "Buka JSON INJECT",
          "variant": "navigation",
          "events": {
            "click": {
              "action": "navigate-route",
              "payload": {
                "routeId": "json-inject"
              }
            }
          }
        },
        {
          "id": "terminal-chrome-launcher-action",
          "type": "Button",
          "style": {
            "$ref": "styles.button-navigation"
          },
          "label": "Buka Chrome Launcher",
          "variant": "navigation",
          "events": {
            "click": {
              "action": "navigate-route",
              "payload": {
                "routeId": "chrome-launcher"
              }
            }
          }
        },
        {
          "id": "terminal-settings-action",
          "type": "Button",
          "style": {
            "$ref": "styles.button-default"
          },
          "label": "Buka Settings",
          "events": {
            "click": {
              "action": "navigate-route",
              "payload": {
                "routeId": "settings"
              }
            }
          }
        }
      ]
    },
    {
      "id": "save-discard-dialog",
      "type": "Dialog",
      "style": {
        "$ref": "styles.dialog"
      },
      "title": "Simpan perubahan?",
      "width": 480,
      "maxHeight": 720,
      "dismissPolicy": {
        "escape": true,
        "outsideClick": false,
        "explicitAction": true
      },
      "children": [
        {
          "id": "save-dialog-description",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "text": "Pilih Simpan, Buang, atau kembali tanpa mengubah apa pun.",
          "variant": "body",
          "wrap": true
        },
        {
          "id": "save-dialog-actions",
          "type": "Container",
          "style": {
            "$ref": "styles.surface"
          },
          "layout": {
            "width": "fill"
          },
          "direction": "row",
          "gap": 8,
          "justify": "end",
          "children": [
            {
              "id": "save-dialog-save",
              "type": "Button",
              "style": {
                "$ref": "styles.button-primary"
              },
              "label": "Simpan",
              "variant": "primary",
              "events": {
                "click": {
                  "action": "dialog-save",
                  "payload": {}
                }
              }
            },
            {
              "id": "save-dialog-discard",
              "type": "Button",
              "style": {
                "$ref": "styles.button-danger"
              },
              "label": "Buang",
              "variant": "danger",
              "events": {
                "click": {
                  "action": "dialog-discard",
                  "payload": {}
                }
              }
            },
            {
              "id": "save-dialog-cancel",
              "type": "Button",
              "style": {
                "$ref": "styles.button-default"
              },
              "label": "Batal",
              "events": {
                "click": {
                  "action": "dialog-cancel",
                  "payload": {}
                }
              }
            }
          ]
        }
      ],
      "events": {
        "accept": {
          "action": "save-confirmation-accepted",
          "payload": {}
        },
        "cancel": {
          "action": "save-confirmation-cancelled",
          "payload": {}
        },
        "dismiss": {
          "action": "save-confirmation-dismissed",
          "payload": {}
        }
      }
    },
    {
      "id": "run-confirm-dialog",
      "type": "Dialog",
      "style": {
        "$ref": "styles.dialog"
      },
      "title": "Jalankan terminal?",
      "width": 480,
      "maxHeight": 720,
      "dismissPolicy": {
        "escape": true,
        "outsideClick": false,
        "explicitAction": true
      },
      "children": [
        {
          "id": "run-confirm-description",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "text": "Terminal akan dibuka pada folder dan target yang dipilih.",
          "variant": "body",
          "wrap": true
        },
        {
          "id": "run-confirm-actions",
          "type": "Container",
          "style": {
            "$ref": "styles.surface"
          },
          "layout": {
            "width": "fill"
          },
          "direction": "row",
          "gap": 8,
          "justify": "end",
          "children": [
            {
              "id": "run-confirm-execute",
              "type": "Button",
              "style": {
                "$ref": "styles.button-primary"
              },
              "label": "Jalankan",
              "variant": "primary",
              "events": {
                "click": {
                  "action": "run-terminal-confirmed",
                  "payload": {}
                }
              }
            },
            {
              "id": "run-confirm-cancel",
              "type": "Button",
              "style": {
                "$ref": "styles.button-default"
              },
              "label": "Batal",
              "events": {
                "click": {
                  "action": "run-terminal-cancel",
                  "payload": {}
                }
              }
            }
          ]
        }
      ],
      "events": {
        "accept": {
          "action": "run-confirmation-accepted",
          "payload": {}
        },
        "cancel": {
          "action": "run-confirmation-cancelled",
          "payload": {}
        },
        "dismiss": {
          "action": "run-confirmation-dismissed",
          "payload": {}
        }
      }
    }
  ]
}
