{
  "id": "ui-editor-screen",
  "type": "Screen",
  "style": {
    "$ref": "styles.surface"
  },
  "routeId": "ui-editor",
  "children": [
    {
      "id": "ui-editor-shell",
      "type": "Container",
      "style": {
        "$ref": "styles.surface"
      },
      "layout": {
        "width": "fill",
        "height": "fill"
      },
      "direction": "column",
      "gap": 10,
      "overflow": "scroll",
      "padding": {
        "left": 24,
        "top": 24,
        "right": 24,
        "bottom": 24
      },
      "children": [
        {
          "id": "ui-editor-title",
          "type": "Text",
          "style": {
            "$ref": "styles.text-title"
          },
          "text": "UI Editor",
          "variant": "title"
        },
        {
          "id": "ui-editor-description",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "text": "Edit token draft untuk membuktikan preview/apply/reload/rollback wiring tanpa menulis override.",
          "variant": "body"
        },
        {
          "id": "ui-editor-draft",
          "type": "Input",
          "style": {
            "$ref": "styles.input"
          },
          "layout": {
            "width": "fill",
            "height": 176
          },
          "valueBinding": {
            "$bind": "viewState.uiEditorDraft"
          },
          "mode": "multiline",
          "maxLength": 0,
          "placeholder": "tokens.accent = #4F8CFF",
          "events": {
            "changed": {
              "action": "update-ui-editor-draft",
              "payload": {}
            }
          }
        },
        {
          "id": "ui-editor-preview-card",
          "type": "Card",
          "style": {
            "$ref": "styles.card"
          },
          "layout": {
            "width": "fill"
          },
          "children": [
            {
              "id": "ui-editor-preview-title",
              "type": "Text",
              "style": {
                "$ref": "styles.text-body"
              },
              "text": "Preview deterministic",
              "variant": "body"
            },
            {
              "id": "ui-editor-preview-button",
              "type": "Button",
              "style": {
                "$ref": "styles.button-primary"
              },
              "label": "Contoh primary button",
              "variant": "primary",
              "events": {
                "click": {
                  "action": "preview-ui-editor-stub",
                  "payload": {}
                }
              }
            }
          ]
        },
        {
          "id": "ui-editor-status",
          "type": "Text",
          "style": {
            "$ref": "styles.text-body"
          },
          "textBinding": {
            "$bind": "viewState.uiEditorStatus"
          },
          "variant": "caption",
          "automation": {
            "name": "Status UI Editor",
            "live": "polite"
          }
        },
        {
          "id": "ui-editor-actions",
          "type": "Container",
          "style": {
            "$ref": "styles.surface"
          },
          "layout": {
            "width": "fill"
          },
          "direction": "row",
          "gap": 8,
          "children": [
            {
              "id": "ui-editor-apply",
              "type": "Button",
              "style": {
                "$ref": "styles.button-primary"
              },
              "label": "Apply stub",
              "variant": "primary",
              "events": {
                "click": {
                  "action": "apply-ui-editor-stub",
                  "payload": {}
                }
              }
            },
            {
              "id": "ui-editor-reload",
              "type": "Button",
              "style": {
                "$ref": "styles.button-default"
              },
              "label": "Reload stub",
              "events": {
                "click": {
                  "action": "reload-ui-editor-stub",
                  "payload": {}
                }
              }
            },
            {
              "id": "ui-editor-rollback",
              "type": "Button",
              "style": {
                "$ref": "styles.button-danger"
              },
              "label": "Rollback stub",
              "variant": "danger",
              "events": {
                "click": {
                  "action": "rollback-ui-editor-stub",
                  "payload": {}
                }
              }
            },
            {
              "id": "ui-editor-back-settings",
              "type": "Button",
              "style": {
                "$ref": "styles.button-subtle"
              },
              "label": "Settings",
              "variant": "subtle",
              "events": {
                "click": {
                  "action": "navigate-route",
                  "payload": {
                    "routeId": "settings"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
